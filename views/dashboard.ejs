<%- include('partials/header', { title: 'Dashboard' }) %>
  <nav class="navbar dash-nav">
    <div class="container nav-container">
      <a href="/dashboard" class="nav-logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        AccessNode
      </a>
      <div class="nav-links">
        <a href="/" class="btn btn-ghost btn-sm" data-tooltip="Back to home">&#8592; Home</a>
        <button class="theme-toggle-btn" id="theme-toggle" data-tooltip="Toggle theme">&#9789;</button>
        <span class="nav-user"><%= user.email %></span>
        <button id="logout-btn" class="btn btn-ghost btn-sm">Sign Out</button>
      </div>
    </div>
  </nav>

  <div class="dashboard">
    <div class="bg-mesh" id="bg-mesh">
      <div class="bg-mesh-orb"></div>
      <div class="bg-mesh-orb"></div>
      <div class="bg-mesh-orb"></div>
    </div>
    <aside class="sidebar">
      <button class="btn btn-primary btn-full" id="add-entry-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Entry
      </button>

      <nav class="sidebar-nav">
        <a href="#" class="sidebar-link active" data-filter="all">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          All Items
          <span class="sidebar-count" id="count-all">0</span>
        </a>
        <a href="#" class="sidebar-link" data-filter="favorites">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Favorites
        </a>
      </nav>

      <div class="sidebar-divider"></div>

      <div class="sidebar-section">
        <div class="sidebar-section-header">
          <span>Categories</span>
          <button class="btn-icon" id="add-category-btn" data-tooltip="Add category">+</button>
        </div>
        <div id="category-list" class="category-list"></div>
      </div>

      <div class="sidebar-section">
        <a href="#" class="sidebar-link" data-filter="trash">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Trash
          <span class="sidebar-count" id="count-trash">0</span>
        </a>
      </div>

      <div class="sidebar-footer">
        <button class="btn btn-ghost btn-full" id="generator-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          Password Generator
        </button>
        <div style="display:flex;gap:6px;">
          <button class="btn btn-ghost btn-xs btn-full" id="export-btn" data-tooltip="Export vault">Export</button>
          <button class="btn btn-ghost btn-xs btn-full" id="import-btn" data-tooltip="Import vault">Import</button>
        </div>
      </div>
    </aside>

    <main class="main-content">
      <div class="welcome-banner" id="welcome-banner">
        <div>
          <div class="welcome-greeting" id="welcome-greeting">Good morning, <span><%= user.email.split('@')[0] %></span></div>
          <div class="welcome-meta">
            <span>Vault: <strong id="welcome-total">0</strong> entries</span>
            <span>Secure: <strong id="welcome-secure">0</strong></span>
          </div>
        </div>
        <div class="status-online"><span class="pulse-dot green"></span> Vault Active</div>
      </div>

      <div class="stats-bar" id="stats-bar">
        <div class="stat-card accent">
          <div class="stat-card-header"><div class="stat-card-icon">&#128274;</div></div>
          <div class="stat-card-value" id="stat-total">0</div>
          <div class="stat-card-label">Total Entries</div>
        </div>
        <div class="stat-card good">
          <div class="stat-card-header"><div class="stat-card-icon">&#10003;</div></div>
          <div class="stat-card-value" id="stat-strong">0</div>
          <div class="stat-card-label">Strong Passwords</div>
        </div>
        <div class="stat-card warn">
          <div class="stat-card-header"><div class="stat-card-icon">&#9888;</div></div>
          <div class="stat-card-value" id="stat-weak">0</div>
          <div class="stat-card-label">Weak / Reused</div>
          <div class="stat-card-sub" id="stat-reused"></div>
        </div>
        <div class="stat-card danger">
          <div class="stat-card-header"><div class="stat-card-icon">&#9203;</div></div>
          <div class="stat-card-value" id="stat-old">0</div>
          <div class="stat-card-label">Older than 6 months</div>
        </div>
      </div>

      <div class="content-header">
        <div class="search-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="search-input" placeholder="Search vault...">
          <span class="search-shortcut">Ctrl+K</span>
          <button id="clear-search" style="display:none;" class="btn-icon">&times;</button>
        </div>
        <div id="trash-info-bar" class="trash-info-bar">
          <span>Items in trash are deleted after <strong>30 days</strong>.</span>
          <button class="btn btn-danger btn-xs" id="empty-trash-btn">Empty Trash</button>
        </div>
        <div class="view-toggle" id="view-toggle" style="margin-left:auto;">
          <button data-view="grid" class="active" data-tooltip="Grid">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button data-view="list" data-tooltip="List">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div id="entries-container" class="entries-container">
        <div class="empty-state">
          <div class="empty-icon">&#128274;</div>
          <h3>Your vault is empty</h3>
          <p>Start by adding your first password or account.</p>
          <button class="btn btn-primary" id="empty-add-btn">+ Add Your First Entry</button>
        </div>
      </div>
    </main>
  </div>

  <!-- Modals -->
  <div id="modal-overlay" class="modal-overlay" style="display:none;">
    <!-- Entry Modal -->
    <div class="modal" id="entry-modal">
      <div class="modal-header">
        <h3 id="modal-title">New Entry</h3>
        <button class="btn-icon modal-close-btn modal-close">&times;</button>
      </div>
      <form id="entry-form">
        <input type="hidden" id="entry-id">
        <div class="form-group">
          <label for="entry-title">Title</label>
          <input type="text" id="entry-title" placeholder="Google, GitHub, Netflix..." required autofocus>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="entry-username">Username / Email</label>
            <input type="text" id="entry-username" placeholder="you@example.com" required>
          </div>
          <div class="form-group">
            <label for="entry-password">Password</label>
            <div class="password-input-group">
              <input type="password" id="entry-password" placeholder="Enter or generate" required>
              <button type="button" class="btn-icon toggle-password" data-target="entry-password" data-tooltip="Show">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
        <div class="sort-bar">
          <span style="font-size:11px;font-weight:700;color:var(--text-tertiary);letter-spacing:0.04em;">SORT</span>
          <select class="sort-select" id="sort-select">
            <option value="updated">Last Updated</option>
            <option value="created">Date Created</option>
            <option value="title">Name A-Z</option>
            <option value="title-desc">Name Z-A</option>
            <option value="category">Category</option>
          </select>
          <div class="density-toggle" id="density-toggle">
            <button data-density="comfortable" class="active" data-tooltip="Comfortable">&#9641;</button>
            <button data-density="compact" data-tooltip="Compact">&#9724;</button>
          </div>
        </div>
      </div>

      <div class="multiselect-bar" id="multiselect-bar">
        <span id="multiselect-count">0 selected</span>
        <button class="btn btn-ghost btn-xs" id="multiselect-pin">Pin</button>
        <button class="btn btn-ghost btn-xs" id="multiselect-export">Export</button>
        <button class="btn btn-danger btn-xs" id="multiselect-delete">Delete</button>
        <button class="btn btn-ghost btn-xs" id="multiselect-clear" style="margin-left:auto;">Cancel</button>
      </div>
            <button type="button" class="btn btn-secondary btn-xs" id="gen-pass-btn" style="margin-top:6px;width:100%;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              Generate Password
            </button>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="entry-url">URL</label>
            <input type="url" id="entry-url" placeholder="https://example.com">
          </div>
          <div class="form-group">
            <label for="entry-category">Category</label>
            <select id="entry-category"><option value="General">General</option></select>
          </div>
        </div>
        <div class="form-group">
          <label for="entry-notes">Secure Notes</label>
          <textarea id="entry-notes" rows="3" placeholder="Recovery codes, security questions..."></textarea>
        </div>
        <div id="password-history-section" style="display:none;margin-bottom:16px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-secondary);margin-bottom:8px;display:block;">Password History</label>
          <div id="password-history-list" class="history-list"></div>
        </div>
        <div class="form-error" id="entry-error" style="display:none;"></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-danger" id="delete-entry-btn" style="display:none;">Move to Trash</button>
          <div class="modal-actions-right">
            <button type="button" class="btn btn-ghost modal-close">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Entry</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Generator Modal -->
    <div class="modal" id="generator-modal" style="display:none;">
      <div class="modal-header">
        <h3>Password Generator</h3>
        <button class="btn-icon modal-close-btn modal-close">&times;</button>
      </div>
      <div class="generator-body">
        <div class="generated-password empty" id="generated-password" data-tooltip="Click to copy">Click Generate</div>
        <div class="gen-options">
          <div class="form-group">
            <label>Length: <strong id="gen-length-val">20</strong></label>
            <input type="range" id="gen-length" min="8" max="64" value="20">
          </div>
          <div class="gen-checks">
            <label class="check-label"><input type="checkbox" id="gen-uppercase" checked> A-Z</label>
            <label class="check-label"><input type="checkbox" id="gen-lowercase" checked> a-z</label>
            <label class="check-label"><input type="checkbox" id="gen-numbers" checked> 0-9</label>
            <label class="check-label"><input type="checkbox" id="gen-symbols" checked> !@#$</label>
          </div>
        </div>
        <div class="gen-actions">
          <button class="btn btn-primary" id="gen-generate">Generate</button>
          <button class="btn btn-ghost" id="gen-copy">Copy</button>
          <button class="btn btn-ghost" id="gen-use">Use in Entry</button>
        </div>
      </div>
    </div>

    <!-- Category Modal -->
    <div class="modal modal-sm" id="category-modal" style="display:none;">
      <div class="modal-header">
        <h3>New Category</h3>
        <button class="btn-icon modal-close-btn modal-close">&times;</button>
      </div>
      <form id="category-form" style="padding:28px;">
        <div class="form-group">
          <label for="cat-name">Name</label>
          <input type="text" id="cat-name" placeholder="Work, Personal, Finance..." required>
        </div>
        <div class="form-group">
          <label for="cat-color">Color</label>
          <input type="color" id="cat-color" value="#6366f1" style="height:42px;cursor:pointer;">
        </div>
        <button type="submit" class="btn btn-primary btn-full">Create Category</button>
      </form>
    </div>

    <!-- Import Modal -->
    <div class="modal modal-sm" id="import-modal" style="display:none;">
      <div class="modal-header">
        <h3>Import Vault</h3>
        <button class="btn-icon modal-close-btn modal-close">&times;</button>
      </div>
      <div style="padding:28px;">
        <div class="import-zone" id="import-zone">
          <div class="import-zone-icon">&#128230;</div>
          <p>Click or drag a <strong>.json</strong> file</p>
          <p style="font-size:11px;color:var(--text-tertiary);margin-top:6px;">Accepts AccessNode export files</p>
          <input type="file" id="import-file" accept=".json">
        </div>
        <div id="import-status" style="margin-top:12px;text-align:center;font-size:13px;color:var(--text-secondary);"></div>
      </div>
    </div>

    <!-- Confirm Modal -->
    <div class="modal modal-sm" id="confirm-modal" style="display:none;">
      <div class="modal-header">
        <h3 id="confirm-title">Confirm</h3>
        <button class="btn-icon modal-close-btn modal-close">&times;</button>
      </div>
      <div class="confirm-body">
        <p id="confirm-message">Are you sure?</p>
        <div class="confirm-actions">
          <button class="btn btn-ghost modal-close" id="confirm-cancel">Cancel</button>
          <button class="btn btn-danger" id="confirm-ok">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>
<%- include('partials/footer') %>
