<%- include('partials/header', { title: 'Sign In' }) %>
  <div class="auth-page">
    <div class="auth-card">
      <a href="/" class="auth-logo">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </a>
      <h1>Welcome back</h1>
      <p class="auth-subtitle">Sign in to your AccessNode vault</p>
      <form id="login-form" class="auth-form" action="/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
        </div>
        <div id="login-error" class="form-error" style="<%= error ? 'display:block;' : 'display:none;' %>"><%= error || '' %></div>
        <button type="submit" class="btn btn-primary btn-full">Sign In</button>
      </form>
      <p class="auth-footer">Don't have an account? <a href="/register">Create one</a></p>
    </div>
  </div>
<%- include('partials/footer') %>
