<%- include('partials/header', { title: 'Secure Password Manager' }) %>
  <div class="landing-bg"><div class="landing-grid"></div></div>

  <nav class="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        AccessNode
      </a>
      <div class="nav-links">
        <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/register" class="btn btn-primary btn-sm">Get Started Free</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <div class="hero-pill">
        <span class="hero-pill-dot"></span>
        Open Source & Self-Hosted
      </div>
      <h1>Your Passwords,<br><span class="gradient-text">Under Your Control</span></h1>
      <p class="hero-desc">
        A beautiful, self-hosted password manager built for privacy.
        Deploy on your own VPS and never trust a third party with your credentials again.
      </p>
      <div class="hero-actions">
        <a href="/register" class="btn btn-primary btn-lg">Start Building Your Vault</a>
        <a href="#features" class="btn btn-secondary btn-lg">Explore Features</a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item">
          <div class="hero-trust-value">AES-256</div>
          <div class="hero-trust-label">Military Encryption</div>
        </div>
        <div class="hero-trust-item">
          <div class="hero-trust-value">Zero</div>
          <div class="hero-trust-label">Data Collected</div>
        </div>
        <div class="hero-trust-item">
          <div class="hero-trust-value">100%</div>
          <div class="hero-trust-label">Open Source</div>
        </div>
        <div class="hero-trust-item">
          <div class="hero-trust-value">SQLite</div>
          <div class="hero-trust-label">Zero Config DB</div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-mock">
          <div class="hero-mock-header">
            <div class="hero-mock-dots"><span></span><span></span><span></span></div>
            My Vault
          </div>
          <div class="hero-mock-body">
            <div class="hero-mock-item">
              <div class="hero-mock-avatar purple">G</div>
              <div class="hero-mock-lines"><div class="hero-mock-line"></div><div class="hero-mock-line short"></div></div>
              <div class="hero-mock-strength strong"></div>
            </div>
            <div class="hero-mock-item">
              <div class="hero-mock-avatar cyan">N</div>
              <div class="hero-mock-lines"><div class="hero-mock-line"></div><div class="hero-mock-line short"></div></div>
              <div class="hero-mock-strength strong"></div>
            </div>
            <div class="hero-mock-item">
              <div class="hero-mock-avatar green">A</div>
              <div class="hero-mock-lines"><div class="hero-mock-line"></div><div class="hero-mock-line short"></div></div>
              <div class="hero-mock-strength fair"></div>
            </div>
            <div class="hero-mock-item">
              <div class="hero-mock-avatar pink">S</div>
              <div class="hero-mock-lines"><div class="hero-mock-line"></div><div class="hero-mock-line short"></div></div>
              <div class="hero-mock-strength strong"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="features">
    <div class="container">
      <div class="section-badge">Features</div>
      <h2 class="section-title">Everything You Need</h2>
      <p class="section-subtitle">A complete password management solution built for privacy and control.</p>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-card-icon">&#128274;</div>
          <h3>AES-256-GCM Encryption</h3>
          <p>Your vault is encrypted with military-grade AES-256-GCM using PBKDF2 key derivation. Data is encrypted before it touches the database.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">&#9889;</div>
          <h3>Password Generator</h3>
          <p>Generate cryptographically strong passwords with customizable length, character sets, and real-time strength analysis.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">&#128451;</div>
          <h3>Smart Organization</h3>
          <p>Categorize entries, star favorites, and search instantly across your vault. Filter by category with one click.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">&#127968;</div>
          <h3>Self-Hosted Freedom</h3>
          <p>Run on your own infrastructure. No subscriptions, no data mining. Your data stays on your server, always.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">&#128203;</div>
          <h3>One-Click Copy</h3>
          <p>Copy usernames and passwords instantly. Each entry supports secure notes for recovery codes and additional details.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">&#127769;</div>
          <h3>Beautiful Interface</h3>
          <p>A polished, responsive dashboard with light/dark themes, keyboard shortcuts, and grid/list views. Fast and distraction-free.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to Take Control?</h2>
      <p>Deploy AccessNode on your VPS in under 5 minutes.</p>
      <a href="/register" class="btn btn-primary btn-lg">Create Free Account</a>
      <div class="cta-stats">
        <div class="cta-stat">
          <div class="cta-stat-value">&lt;5 min</div>
          <div class="cta-stat-label">Setup Time</div>
        </div>
        <div class="cta-stat">
          <div class="cta-stat-value">MIT</div>
          <div class="cta-stat-label">License</div>
        </div>
        <div class="cta-stat">
          <div class="cta-stat-value">Docker</div>
          <div class="cta-stat-label">Ready</div>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div>
          <div class="footer-brand">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>AccessNode</span>
          </div>
          <p>Self-hosted password & account manager</p>
        </div>
        <div class="footer-links">
          <a href="/setup">Setup Guide</a>
          <a href="/login">Sign In</a>
          <a href="/register">Register</a>
        </div>
      </div>
    </div>
  </footer>
<%- include('partials/footer') %>
