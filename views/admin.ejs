<%- include('partials/header', { title: 'Admin Panel' }) %>
  <nav class="navbar">
    <div class="container nav-container">
      <a href="/dashboard" class="nav-logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        AccessNode
      </a>
      <div class="nav-links">
        <a href="/dashboard" class="btn btn-ghost btn-sm">&#8592; Dashboard</a>
        <span class="nav-user"><%= user.email %></span>
        <button id="logout-btn" class="btn btn-ghost btn-sm">Sign Out</button>
      </div>
    </div>
  </nav>

  <style>
    .admin-page { max-width: 1000px; margin: 0 auto; padding: 40px 32px; }
    .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .admin-header h1 { font-size: 28px; font-weight: 900; letter-spacing: -0.03em; }
    .admin-badge { background: var(--accent); color: #fff; padding: 4px 14px; border-radius: var(--radius-full); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }
    .alert { padding: 12px 18px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 13px; font-weight: 500; }
    .alert-success { background: var(--green-subtle); border: 1px solid rgba(34,197,94,0.3); color: var(--green); }
    .alert-error { background: var(--red-subtle); border: 1px solid rgba(239,68,68,0.3); color: var(--red); }
    .admin-section { margin-bottom: 40px; }
    .admin-section h2 { font-size: 18px; font-weight: 700; margin-bottom: 16px; }
    .users-table { width: 100%; border-collapse: collapse; }
    .users-table th { text-align: left; font-size: 11px; font-weight: 700; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; padding: 10px 14px; border-bottom: 1px solid var(--border-subtle); }
    .users-table td { padding: 12px 14px; border-bottom: 1px solid var(--border-subtle); font-size: 14px; }
    .users-table tr:hover td { background: var(--bg-hover); }
    .admin-tag { display: inline-block; background: var(--accent-subtle); color: var(--accent-light); padding: 2px 10px; border-radius: var(--radius-full); font-size: 11px; font-weight: 700; }
    .user-tag { display: inline-block; background: var(--bg-elevated); color: var(--text-tertiary); padding: 2px 10px; border-radius: var(--radius-full); font-size: 11px; font-weight: 600; }
    .add-user-form { display: grid; grid-template-columns: 2fr 1.5fr 0.8fr auto; gap: 10px; align-items: end; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 20px; }
    .add-user-form .form-group { margin-bottom: 0; }
    .modal-inline { display: none; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); margin-top: 12px; }
    .modal-inline.active { display: block; }
    .modal-inline h4 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
    .modal-inline form { display: grid; grid-template-columns: 2fr auto auto; gap: 10px; align-items: end; }
    @media (max-width: 768px) {
      .add-user-form { grid-template-columns: 1fr 1fr; }
      .users-table { font-size: 12px; }
      .users-table th, .users-table td { padding: 8px 10px; }
      .modal-inline form { grid-template-columns: 1fr; }
    }
  </style>

  <div class="admin-page">
    <div class="admin-header">
      <div>
        <h1>Admin Panel <span class="admin-badge">Admin</span></h1>
        <p style="color:var(--text-secondary);font-size:14px;">Manage users and access</p>
      </div>
      <span style="color:var(--text-tertiary);font-size:13px;"><%= users.length %> users</span>
    </div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="admin-section">
      <h2>Add New User</h2>
      <form class="add-user-form" action="/admin/users" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="new-email">Email</label>
          <input type="email" id="new-email" name="email" placeholder="user@example.com" required>
        </div>
        <div class="form-group">
          <label for="new-password">Password</label>
          <input type="password" id="new-password" name="password" placeholder="Min. 8 characters" required minlength="8">
        </div>
        <div class="form-group">
          <label for="new-admin">Role</label>
          <select id="new-admin" name="is_admin">
            <option value="0">User</option>
            <option value="1">Admin</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Create User</button>
      </form>
    </div>

    <div class="admin-section">
      <h2>All Users</h2>
      <table class="users-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Entries</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><strong><%= u.email %></strong></td>
              <td><%= u.is_admin ? '<span class="admin-tag">Admin</span>' : '<span class="user-tag">User</span>' %></td>
              <td><%= u.entryCount %></td>
              <td style="color:var(--text-tertiary);font-size:13px;"><%= new Date(u.created_at).toLocaleDateString() %></td>
              <td>
                <div style="display:flex;gap:6px;">
                  <button class="btn btn-ghost btn-xs" onclick="toggleReset('<%= u.id %>')">Reset PW</button>
                  <% if (u.id !== user.id) { %>
                    <form action="/admin/users/<%= u.id %>/toggle-admin" method="POST" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs"><%= u.is_admin ? 'Revoke' : 'Make Admin' %></button>
                    </form>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete <%= u.email %>? This removes all their data.')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs" style="color:var(--red);">Delete</button>
                    </form>
                  <% } else { %>
                    <span style="font-size:11px;color:var(--text-tertiary);">You</span>
                  <% } %>
                </div>
                <div class="modal-inline" id="reset-<%= u.id %>">
                  <h4>Reset password for <%= u.email %></h4>
                  <form action="/admin/users/<%= u.id %>/reset-password" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="password" name="password" placeholder="New password (min 8 chars)" required minlength="8" style="padding:8px 12px;background:var(--bg-input);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:var(--text-primary);font-size:14px;font-family:var(--font-sans);">
                    <button type="submit" class="btn btn-primary btn-xs">Reset</button>
                    <button type="button" class="btn btn-ghost btn-xs" onclick="toggleReset('<%= u.id %>')">Cancel</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    function toggleReset(id) {
      var el = document.getElementById('reset-' + id);
      if (el) el.classList.toggle('active');
    }
    document.getElementById('logout-btn').addEventListener('click', function(e) {
      e.preventDefault();
      fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') }, credentials: 'same-origin' })
        .then(function() { window.location.href = '/'; });
    });
    document.querySelectorAll('form[onsubmit]').forEach(function(f) {
      f.addEventListener('submit', function(e) {
        if (!confirm(f.getAttribute('onsubmit').replace('return confirm(\'', '').replace('\')', ''))) {
          e.preventDefault();
        }
      });
    });
  </script>
<%- include('partials/footer') %>
